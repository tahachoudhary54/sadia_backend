# Server configuration
PORT=5000
NODE_ENV=development

# Database configuration
# Place your MongoDB connection string here (Atlas cluster or Local URI)
MONGODB_URI=mongodb://localhost:27017/sadiafragnance

# Authentication
# Secret key to sign JSON Web Tokens (JWT)
JWT_SECRET=super_secret_jwt_sign_key_change_me_in_production
